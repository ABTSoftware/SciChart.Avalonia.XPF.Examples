<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:SciChart.Examples.Demo.Controls"
                    xmlns:elctrl="clr-namespace:SciChart.Examples.Demo.Controls.EndlessItemsControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Scrollbars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="elctrl:EndlessItemsControl">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="elctrl:EndlessItemsControl">
                    <ScrollViewer x:Name="PART_ScrollViewer"
                                  BorderThickness="0"
                                  HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                  VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource OverlayScrollViewerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">

                                <ItemsPresenter/>
                            </Border>

                            <ctrl:LoadingIndicator x:Name="loadingIndicator"
                                                   Grid.Row="1"
                                                   Margin="0,10"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBusy, Mode=OneWay, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="loadingIndicator" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>